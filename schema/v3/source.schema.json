{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getbible.net/schema/v3/source.schema.json",
  "title": "getBible API v3 native source extension",
  "type": "object",
  "$defs": {
    "byteValue": {
      "type": "object",
      "required": ["base64", "encoding", "sha256", "size"],
      "properties": {
        "base64": {"type": "string", "contentEncoding": "base64"},
        "encoding": {"const": "base64"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0},
        "utf8": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sourceContract": {
      "type": "object",
      "required": [
        "contract", "producer", "producer_version", "sword_version",
        "stream_sha256", "entries", "artifacts", "artifact_bytes"
      ],
      "properties": {
        "contract": {"const": "getbiblesword.ndjson/v1"},
        "producer": {"const": "getBibleSword"},
        "producer_version": {"type": "string"},
        "sword_version": {"type": "string"},
        "stream_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entries": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "integer", "minimum": 0},
        "artifact_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "entrySource": {
      "type": "object",
      "required": [
        "contract", "entry_ordinal", "key", "scope", "raw",
        "rendered_default", "stripped", "projections_available",
        "official_attributes", "annotation_segments"
      ],
      "properties": {
        "contract": {"const": "getbiblesword.ndjson/v1"},
        "entry_ordinal": {"type": "integer", "minimum": 0},
        "key": {"$ref": "#/$defs/byteValue"},
        "scope": {"type": "object"},
        "raw": {"$ref": "#/$defs/byteValue"},
        "rendered_default": {
          "oneOf": [{"$ref": "#/$defs/byteValue"}, {"type": "null"}]
        },
        "stripped": {
          "oneOf": [{"$ref": "#/$defs/byteValue"}, {"type": "null"}]
        },
        "projections_available": {"type": "boolean"},
        "official_attributes": {"type": "array"},
        "annotation_segments": {"type": "array"}
      },
      "additionalProperties": false
    },
    "translationSource": {
      "type": "object",
      "required": [
        "module", "config_sources", "config_entries", "diagnostics", "unknown_records"
      ],
      "properties": {
        "module": {"type": "object"},
        "config_sources": {"type": "array"},
        "config_entries": {"type": "array"},
        "diagnostics": {"type": "array"},
        "unknown_records": {"type": "array"}
      },
      "additionalProperties": false
    },
    "introduction": {
      "type": "object",
      "required": ["scope", "text", "source"],
      "properties": {
        "scope": {"type": "object"},
        "text": {"type": "string"},
        "source": {"$ref": "#/$defs/entrySource"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "source_contract": {"$ref": "#/$defs/sourceContract"},
    "source": {
      "oneOf": [
        {"$ref": "#/$defs/entrySource"},
        {"$ref": "#/$defs/translationSource"}
      ]
    },
    "introduction": {
      "type": "array",
      "items": {"$ref": "#/$defs/introduction"}
    },
    "introductions": {
      "type": "array",
      "items": {"$ref": "#/$defs/introduction"}
    }
  },
  "additionalProperties": true
}
