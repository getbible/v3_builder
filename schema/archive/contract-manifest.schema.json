{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getbible.net/schema/archive/contract-manifest.schema.json",
  "title": "GetBible validated contract archive manifest",
  "type": "object",
  "required": [
    "schema", "contract", "producer_versions", "sword_versions",
    "module_count", "modules"
  ],
  "properties": {
    "schema": {"const": "getbible.contract-archive-manifest/v1"},
    "contract": {"const": "getbiblesword.ndjson/v1"},
    "producer_versions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "sword_versions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "module_count": {"type": "integer", "minimum": 0},
    "modules": {
      "type": "array",
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "module": {
      "type": "object",
      "required": [
        "module", "classification", "file", "file_size", "file_sha256",
        "stream_sha256", "entries", "artifacts", "artifact_bytes",
        "diagnostics", "unknown_record_types"
      ],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "file": {"type": "string", "pattern": "^[^/]+\\.ndjson$"},
        "file_size": {"type": "integer", "minimum": 0},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "stream_sha256": {"$ref": "#/$defs/sha256"},
        "entries": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "integer", "minimum": 0},
        "artifact_bytes": {"type": "integer", "minimum": 0},
        "diagnostics": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "unknown_record_types": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
