{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial.schema.json",
  "title": "Editorial",
  "description": "The source reading layout of one chapter in reading order. Existing headings remain anchored before a verse, and paragraphs remain inclusive verse-number ranges. Footnotes retain complete bodies and internal structure; structure entries retain additional source constructs. order is contiguous and zero-based across every entry. Paragraph entries, when present, cover every emitted verse contiguously. Absent when there are no entries.",
  "type": "array",
  "minItems": 1,
  "items": {
    "oneOf": [
      {
        "$ref": "#/$defs/heading"
      },
      {
        "$ref": "#/$defs/paragraph"
      },
      {
        "$ref": "#/$defs/footnote"
      },
      {
        "$ref": "#/$defs/structure"
      }
    ]
  },
  "$defs": {
    "heading": {
      "title": "Heading",
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Position of the entry in the array."
        },
        "type": {
          "const": "heading"
        },
        "anchor": {
          "type": "object",
          "properties": {
            "verse": {
              "type": "integer",
              "minimum": 1,
              "description": "The verse the heading precedes."
            },
            "edge": {
              "const": "before"
            }
          },
          "required": [
            "verse",
            "edge"
          ],
          "additionalProperties": false
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The heading text."
        },
        "heading_type": {
          "type": "string",
          "minLength": 1,
          "description": "The source title type in OSIS-equivalent semantics, or unspecified when the source supplies none."
        },
        "canonical": {
          "type": "boolean",
          "description": "True only when the source explicitly marks the heading canonical."
        },
        "content": {
          "$ref": "content.schema.json"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Source attributes retained as strings. Content links use reference_id or footnote_id to identify chapter study entries."
        },
        "subtype": {
          "type": "string"
        },
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "token.schema.json"
          },
          "description": "Title-local word tokens; positions address heading text."
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "span.schema.json"
          },
          "description": "Title-local annotations; ranges address heading tokens and text."
        }
      },
      "required": [
        "order",
        "type",
        "anchor",
        "text",
        "heading_type",
        "canonical"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "tokens": [
          "spans"
        ],
        "spans": [
          "tokens"
        ]
      }
    },
    "paragraph": {
      "title": "Paragraph",
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Position of the entry in the array."
        },
        "type": {
          "const": "paragraph"
        },
        "start": {
          "type": "integer",
          "minimum": 1,
          "description": "First verse of the paragraph."
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "description": "Last verse of the paragraph, inclusive."
        }
      },
      "required": [
        "order",
        "type",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "footnote": {
      "title": "Footnote",
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "anchor": {
          "$ref": "anchor.schema.json"
        },
        "content": {
          "$ref": "content.schema.json"
        },
        "type": {
          "const": "footnote"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Source attributes retained as strings. Content links use reference_id or footnote_id to identify chapter study entries."
        }
      },
      "required": [
        "order",
        "type",
        "id",
        "anchor",
        "text",
        "content"
      ],
      "additionalProperties": false
    },
    "structure": {
      "title": "Source structure",
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "anchor": {
          "$ref": "anchor.schema.json"
        },
        "content": {
          "$ref": "content.schema.json"
        },
        "type": {
          "const": "structure"
        }
      },
      "required": [
        "order",
        "type",
        "anchor",
        "content"
      ],
      "additionalProperties": false
    }
  }
}
